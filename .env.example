# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings > API in the Supabase dashboard).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Service-role key: server-only, never exposed to the client bundle.
# Used for the /attendance kiosk flow and admin bootstrap.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# face-service (../Insightface/face-service) -- server-only, never exposed
# to the client bundle. FACE_SERVICE_API_KEY must match INTERNAL_API_KEY in face-service/.env.
FACE_SERVICE_URL=http://localhost:8001
FACE_SERVICE_API_KEY=replace-with-the-same-value-as-face-service-internal-api-key
