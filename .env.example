# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings > API in the Supabase dashboard).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Service-role key: server-only, never exposed to the client bundle.
# Used for the /attendance kiosk flow and admin bootstrap.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# face-service (../Insightface/face-service) -- server-only, never exposed
# to the client bundle. FACE_SERVICE_API_KEY must match INTERNAL_API_KEY in face-service/.env.
FACE_SERVICE_URL=http://localhost:8001
FACE_SERVICE_API_KEY=replace-with-the-same-value-as-face-service-internal-api-key

# Google Apps Script web app that uploads ID proof PDFs to Drive -- server-only, never
# exposed to the client bundle. See google-apps-script/upload-id-proof.gs and SETUP.md
# for deployment steps. The endpoint has no shared secret, so this URL is itself the only
# thing gating writes into the Drive folder -- keep it out of the client bundle.
GOOGLE_DRIVE_UPLOAD_URL=https://script.google.com/macros/s/your-deployment-id/exec
